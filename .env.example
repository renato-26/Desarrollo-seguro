# Copiar a .env; asignar contraseña local antes de ejecutar Compose.
APP_ENV=dev
NODE_ENV=development
PORT=3000
POSTGRES_DB=pnk_security
POSTGRES_USER=pnk_app
POSTGRES_PASSWORD=
# Fuera de Docker: completar contraseña, codificada para URL si corresponde.
DATABASE_URL=postgresql://pnk_app:CHANGE_ME@127.0.0.1:5432/pnk_security
DB_SSL=disable
